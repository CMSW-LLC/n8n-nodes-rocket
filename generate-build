#!/bin/bash
set -e

# Exec 1 + Exec 2: Geração completa seguida de build adicional
# 1. Exec 1: Gera arquivos + lint + build
# 2. Exec 2: lint + build adicional
# Requer: CMSW_API_KEY para Exec 1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "==> Iniciando Exec 1 (generate)..."
./generate

echo ""
echo "==> Iniciando Exec 2 (build)..."
./build

echo ""
echo "==> Exec 1 + Exec 2 concluídos com sucesso!"

